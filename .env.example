# Copy to .env. Compose reads it for the host mounts below and passes every
# variable into the container, where ClearML is discovered automatically.

# Host directories mounted into the container.
SCIML_ROOT=/mnt/sciml
NESTP_ROOT=/mnt/nestp

# NVIDIA GPU device ID exposed to the container (for example, 0 or 1).
GPU_DEVICE_ID=0

# ClearML credentials (from the web UI "Settings > Workspace > Create new
# credentials" dialog). Fill these in to log to ClearML; leave them blank to
# log locally to ./outputs.
CLEARML_WEB_HOST=
CLEARML_API_HOST=
CLEARML_FILES_HOST=
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
